rules_version = '2';

// Carpool Planner: access by secret link.
// Anyone who knows a carpool's id can read and edit it. Nobody can list
// carpools, so an id can't be discovered. Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function validCarpool(d) {
      return d.keys().hasOnly(['name', 'location', 'startTime', 'endTime', 'parents', 'kids', 'createdAt'])
        && d.keys().hasAll(['name', 'location', 'startTime', 'endTime', 'parents', 'kids', 'createdAt'])
        && d.name is string && d.name.size() <= 100
        && d.location is string && d.location.size() <= 200
        && d.startTime is string && d.startTime.size() <= 8
        && d.endTime is string && d.endTime.size() <= 8
        && d.parents is list && d.parents.size() <= 30
        && d.kids is list && d.kids.size() <= 50
        && d.createdAt is string && d.createdAt.size() <= 40;
    }

    // `weight` is optional: how many legs each drive on that day counts as (missing means 1).
    function validRide(rideId, d) {
      return d.keys().hasOnly(['date', 'to', 'home', 'cancelled', 'note', 'updatedAt', 'weight'])
        && d.keys().hasAll(['date', 'to', 'home', 'cancelled', 'note'])
        && rideId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.date == rideId
        && d.to is string && d.to.size() <= 40
        && d.home is string && d.home.size() <= 40
        && d.cancelled is bool
        && d.note is string && d.note.size() <= 500
        && (!('updatedAt' in d) || (d.updatedAt is string && d.updatedAt.size() <= 40))
        && (!('weight' in d) || (d.weight is number && d.weight >= 0.5 && d.weight <= 5));
    }

    // A change-log entry. `at` must be the server's time of the write, so it can't be backdated.
    function validLog(d) {
      return d.keys().hasOnly(['at', 'by', 'kind', 'summary', 'changes'])
        && d.keys().hasAll(['at', 'by', 'kind', 'summary', 'changes'])
        && d.at == request.time
        && d.by is string && d.by.size() <= 60
        && d.kind is string && d.kind.size() <= 20
        && d.summary is string && d.summary.size() <= 1000
        && d.changes is list && d.changes.size() <= 100;
    }

    match /carpools/{cid} {
      allow get: if true;
      allow create: if cid.size() >= 20 && validCarpool(request.resource.data);
      allow update: if validCarpool(request.resource.data);
      allow list, delete: if false;

      match /rides/{rideId} {
        allow read: if true;
        // Rides can only be written under a carpool that exists (or is being
        // created in the same batch), so stray ids can't collect junk data.
        allow create, update: if existsAfter(/databases/$(database)/documents/carpools/$(cid))
          && validRide(rideId, request.resource.data);
        allow delete: if true;
      }

      // Change log: anyone with the carpool's id can read it and add to it, nobody can
      // edit or delete entries. There's no collection-group rule, so logs can only be
      // listed under a known carpool id.
      match /log/{entryId} {
        allow read: if true;
        allow create: if existsAfter(/databases/$(database)/documents/carpools/$(cid))
          && validLog(request.resource.data);
        allow update, delete: if false;
      }
    }
  }
}
